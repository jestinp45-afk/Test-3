rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/appData/{dataKey} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && dataKey in ['transformer_tasks', 'transformer_journal', 'transformer_questions', 'transformer_auto_theme', 'transformer_manual_theme', 'transformer_reminders', 'transformer_notifications_enabled'];
    }
  }
}
